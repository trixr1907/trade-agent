# --- Exchange (Bitget) ---
# Nur API-Keys hier setzen — niemals im Quellcode hardcodieren.
# Permissions: für Live-Trading "Trade" + eingeschränkt "Read".
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- Execution mode ---
# "paper" (Standard, Empfehlung) oder "live" (nur nach Freigabe & Limits)
TRADING_MODE=paper

# --- Live-Sicherheitslimits (handelt nur bei TRADING_MODE=live) ---
LIVE_MAX_POSITION_NOTIONAL_USD=500
LIVE_MAX_OPEN_POSITIONS=3
LIVE_SYMBOL_ALLOWLIST=BTC/USDT,ETH/USDT

# --- Risk-Management ---
RISK_MAX_DRAWDOWN_PCT=0.15      # 15% Max-Drawdown-Budget
RISK_KELLY_FRACTION=0.25        # Kelly-Skalierung (fraction of full Kelly)
RISK_ATR_STOP_MULT=2.5          # ATR-Stop-Multiplikator
RISK_MIN_SCORE=60               # Signal-Score, ab dem ein Antrag erzeugt wird

# --- LLM Analyst (optional) ---
# Wird nur zur Formulierung des Narrativs genutzt, NEVER zur Entscheidung.
LLM_API_KEY=
LLM_MODEL=

# --- Server ---
HOST=0.0.0.0
PORT=8000
