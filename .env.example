# --- Exchange (Bitget) ---
# Nur API-Keys hier setzen — niemals im Quellcode hardcodieren.
# Permissions: für Live-Trading "Trade" + eingeschränkt "Read".
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# --- Demo-Trading (Bitget Demo, fiktive Bilanzen) ---
# BITGET_DEMO=true schaltet CCXT in den Demo-Modus (Header PAPTRADING: 1) und lädt
# ausschließlich die BITGET_DEMO_API_*-Keys. Die Live-Keys oben werden dann ignoriert.
# Demo-Keys im Bitget-Demo-Bereich erzeugen, nie Live-Keys hier eintragen.
BITGET_DEMO=false
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=

# --- Bitget-Kontotyp ---
# Fest konfiguriert, CCXT erkennt den Kontotyp nicht mehr automatisch.
# false = klassisches Konto, klassische Mix-Endpunkte (Standard); true = UTA (Unified Trading Account).
# Erlaubt: true/True/1 oder false/False/0. Jeder andere Wert bricht den Start ab (fail-closed).
BITGET_UTA=false

# --- Live-Produkt: USDT-Perpetuals (swap) ---
# Margin-Modus pro Symbol: "isolated" (Standard, hält Per-Position-Limits durchsetzbar) oder "cross".
BITGET_MARGIN_MODE=isolated
# Hebel pro Symbol. Der Relay lehnt Orders ab, deren Stop-Distanz nicht klar vor der Liquidation liegt.
BITGET_LEVERAGE=3

# --- Execution mode ---
# "paper" (Standard, Empfehlung) oder "live" (nur nach Freigabe & Limits)
TRADING_MODE=paper

# --- Live-Sicherheitslimits (handelt nur bei TRADING_MODE=live) ---
LIVE_MAX_POSITION_NOTIONAL_USD=500
LIVE_MAX_OPEN_POSITIONS=3
# Perp-Format. Der Relay mappt BTC/USDT -> BTC/USDT:USDT und prüft das gemappte Symbol.
# Gesetzt  -> Modus "explicit": nur diese Symbole sind live handelbar.
# Leer     -> Modus "all": alle per fetch_markets() entdeckten USDT-Perps (swap, linear, aktiv).
#             Ist die Entdeckung nicht verfügbar, wird jedes Symbol abgelehnt (fail-closed).
LIVE_SYMBOL_ALLOWLIST=BTC/USDT:USDT,ETH/USDT:USDT

# --- Symbol-Universe (USDT-Perps von Bitget) ---
# Cache-Dauer der entdeckten Symbolmenge in Sekunden.
UNIVERSE_TTL_SECONDS=600
# Wie lange ein alter Stand bei Abruffehlern noch gilt (mindestens TTL); danach fail-closed.
UNIVERSE_MAX_STALE_SECONDS=3600

# --- Risk-Management ---
RISK_MAX_DRAWDOWN_PCT=0.15      # 15% Max-Drawdown-Budget
RISK_KELLY_FRACTION=0.25        # Kelly-Skalierung (fraction of full Kelly)
RISK_ATR_STOP_MULT=2.5          # ATR-Stop-Multiplikator
RISK_MIN_SCORE=60               # Signal-Score, ab dem ein Antrag erzeugt wird

# --- LLM Analyst (optional) ---
# Wird nur zur Formulierung des Narrativs genutzt, NEVER zur Entscheidung.
LLM_API_KEY=
LLM_MODEL=

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Dashboard-Login (Phase 4) ---
# Hash erzeugen: python -m tradeagent.api.auth (Passwort nie im Klartext eintragen).
# Ohne beide Werte ist kein Login moeglich (fail-closed).
AUTH_USERNAME=
AUTH_PASSWORD_HASH=''
# Session-Dauer in Minuten (1-1440)
AUTH_SESSION_TTL_MINUTES=60

# --- Monitor & Alerts (Phase 5) ---
# Intervall des Sync- und Risiko-Monitors in Sekunden.
MONITOR_INTERVAL_SECONDS=60
# Optionaler generischer Webhook (HTTP-POST mit JSON bei neuen Alarmen). Leer = aus.
ALERT_WEBHOOK_URL=
